<link rel="stylesheet" href="~/css/Email.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Password Reset Link Was Sent!";
}

<link rel="stylesheet" href="~/css/Email.css" asp-append-version="true" />

<div class="login-wrapper">
    <div class="login-container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

                <div class="login-card success-card">
                    <div class="login-card-body">

                        <!-- Success Icon -->
                        <div class="success-icon-wrapper">
                            <div class="success-icon">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="success-pulse"></div>
                        </div>

                        <!-- Header Section -->
                        <div class="login-header">
                            <h1 class="login-title success-title">Nearly There!</h1>
                            <p class="login-subtitle">A link to reset your password was sent to your email address.</p>
                        </div>

                        <!-- Success Message Card -->
                        <div class="success-message-box">
                            <div class="success-message-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div class="success-message-content">
                                <p>
                                    Thank you for your patience, please check your email address and follow the instructions.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Info -->
                <div class="login-extra-info">
                    <p>
                        <i class="bi bi-shield-lock me-1"></i>
                        Your account is secured with industry-standard encryption
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        // Add celebration animation on page load
        document.addEventListener('DOMContentLoaded', function() {
            const successIcon = document.querySelector('.success-icon');

            // Trigger animations
            setTimeout(() => {
                successIcon.style.transform = 'scale(1.15) rotate(360deg)';
                setTimeout(() => {
                    successIcon.style.transform = 'scale(1) rotate(360deg)';
                }, 400);
            }, 200);

            // Add confetti effect
            createConfetti();

            // Add shimmer effect to features
            const features = document.querySelectorAll('.features-list li');
            features.forEach((feature, index) => {
                setTimeout(() => {
                    feature.style.animation = 'shimmer 0.6s ease-out';
                }, 600 + (index * 100));
            });
        });

        function createConfetti() {
            const colors = ['#059669', '#10b981', '#34d399', '#6ee7b7'];
            const confettiCount = 40;

            for (let i = 0; i < confettiCount; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.className = 'confetti';
                    confetti.style.left = Math.random() * 100 + '%';
                    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.animationDelay = Math.random() * 0.5 + 's';
                    confetti.style.animationDuration = (Math.random() * 2 + 2) + 's';
                    document.querySelector('.login-wrapper').appendChild(confetti);

                    setTimeout(() => confetti.remove(), 4000);
                }, i * 40);
            }
        }
    </script>
}