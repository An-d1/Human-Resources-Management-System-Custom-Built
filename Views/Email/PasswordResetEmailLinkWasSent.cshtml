<link rel="stylesheet" href="~/css/Email.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Password Reset Link Was Sent!";
}

<link rel="stylesheet" href="~/css/Email.css" asp-append-version="true" />

<div class="login-wrapper">
    <div class="login-container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

                <div class="login-card success-card">
                    <div class="login-card-body">

                        <!-- Success Icon -->
                        <div class="success-icon-wrapper">
                            <div class="success-icon">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="success-pulse"></div>
                        </div>

                        <!-- Header Section -->
                        <div class="login-header">
                            <h1 class="login-title success-title">Nearly There!</h1>
                            <p class="login-subtitle">A link to reset your password was sent to your email address.</p>
                        </div>

                        <!-- Success Message Card -->
                        <div class="success-message-box">
                            <div class="success-message-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div class="success-message-content">
                                <p>
                                    Thank you for your patience, please check your email address and follow the instructions.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Info -->
                <div class="login-extra-info">
                    <p>
                        <i class="bi bi-shield-lock me-1"></i>
                        Your account is secured with industry-standard encryption
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
<script>
    // Add celebration animation on page load
    document.addEventListener('DOMContentLoaded', function() {
        const successIcon = document.querySelector('.success-icon');
        const successCard = document.querySelector('.success-card');

        // Trigger animations
        setTimeout(() => {
            successIcon.style.transform = 'scale(1.1)';
            setTimeout(() => {
                successIcon.style.transform = 'scale(1)';
            }, 300);
        }, 200);
    });
</script>
}
