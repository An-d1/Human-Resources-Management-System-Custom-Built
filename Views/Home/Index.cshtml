@model HRManagementSystem.ViewModels.EmployeeViewModel

<link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@ViewData["Title"] - HR Portal</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />

<div class="dashboard-wrapper">

    <!-- Main Content Area -->
    <div class="dashboard-main">

        <!-- Top Navigation Bar -->
        <header class="dashboard-header">
            <div class="header-left">
                <button class="mobile-menu-toggle" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>
                <div class="header-welcome">
                    <h1 class="header-title">Welcome Back, @Model.FirstName </h1>
                    <p class="header-subtitle">Here’s your work overview today</p>
                </div>
            </div>

            <div class="header-right">
                <!-- Notifications -->
                <div class="header-icon-btn">
                    <i class="bi bi-bell"></i>
                    <span class="notification-badge">2</span>
                </div>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <button class="user-profile-dropdown" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">EM</div>
                        <div class="user-info">
                            <span class="user-name">@Model.FirstName</span>
                            <span class="user-email">@Model.Email</span>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2"></i> Profile</a></li>
                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i> Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-controller="Login" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="dashboard-content">
            @await Html.PartialAsync("_FlashMessages")

            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card stat-card-primary">
                    <div class="stat-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Hours Worked (Month)</span>
                        <h2 class="stat-value">—</h2>
                        <span class="stat-description">Total logged hours</span>
                    </div>
                </div>

                <div class="stat-card stat-card-success">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-week"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Next Shift</span>
                        <h2 class="stat-value">—</h2>
                        <span class="stat-description">Scheduled workday</span>
                    </div>
                </div>

                <div class="stat-card stat-card-info">
                    <div class="stat-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Last Payroll</span>
                        <h2 class="stat-value">—</h2>
                        <span class="stat-description">Most recent payment</span>
                    </div>
                </div>

                <div class="stat-card stat-card-warning">
                    <div class="stat-icon">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Pending Actions</span>
                        <h2 class="stat-value">—</h2>
                        <span class="stat-description">Your required tasks</span>
                    </div>
                </div>
            </div>

            <!-- Content Grid -->
            <div class="content-grid">

                <!-- Recent Activity -->
                <div class="content-card activity-card">
                    <div class="card-header-custom">
                        <h3 class="card-title-custom">Recent Activity</h3>
                    </div>
                    <div class="card-body-custom">
                        <ul class="activity-list">
                            <li class="activity-item">
                                <div class="activity-icon activity-icon-success">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-text">You checked in</p>
                                    <span class="activity-time">5 hours ago</span>
                                </div>
                            </li>

                            <li class="activity-item">
                                <div class="activity-icon activity-icon-primary">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-text">Shift scheduled for tomorrow</p>
                                    <span class="activity-time">1 day ago</span>
                                </div>
                            </li>

                            <li class="activity-item">
                                <div class="activity-icon activity-icon-info">
                                    <i class="bi bi-cash"></i>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-text">Payroll processed</p>
                                    <span class="activity-time">3 days ago</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="content-card actions-card">
                    <div class="card-header-custom">
                        <h3 class="card-title-custom">Quick Actions</h3>
                    </div>
                    <div class="card-body-custom">
                        <div class="quick-actions">

                            <a asp-controller="Home" asp-action="CheckInOut" class="action-btn action-btn-primary">
                                <div class="action-icon">
                                    <i class="bi bi-clock"></i>
                                </div>
                                <div class="action-content">
                                    <span class="action-title">Check In/Out</span>
                                    <span class="action-description">Log your shift time</span>
                                </div>
                            </a>

                            <a asp-controller="Employee" asp-action="Schedule" class="action-btn action-btn-info">
                                <div class="action-icon">
                                    <i class="bi bi-calendar-week"></i>
                                </div>
                                <div class="action-content">
                                    <span class="action-title">My Schedule</span>
                                    <span class="action-description">View upcoming shifts</span>
                                </div>
                            </a>

                            <a asp-controller="Employee" asp-action="Payroll" class="action-btn action-btn-success">
                                <div class="action-icon">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                                <div class="action-content">
                                    <span class="action-title">Payroll</span>
                                    <span class="action-description">View your payments</span>
                                </div>
                            </a>

                        </div>
                    </div>
                </div>

            </div>

        </main>

    </div>
</div>
