@using HRManagementSystem.Enums
@model HRManagementSystem.ViewModels.LeaveRequestViewModel

@{
    ViewData["Title"] = "Request Leave";
}

<link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />

<div class="dashboard-wrapper">

    <!-- Main Content Area -->
    <div class="dashboard-main">

        <!-- Top Navigation Bar -->
        <header class="dashboard-header">

            <div class="header-left">
                <button class="mobile-menu-toggle" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>

                <div class="header-welcome">
                    <h1 class="header-title">Request Leave</h1>
                    <p class="header-subtitle">
                        Submit a leave request for admin approval
                    </p>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->

                <!-- Leave Request Card -->
                <div class="content-card m-5">

                    <div class="card-header-custom">
                        <h3 class="card-title-custom">
                            <i class="bi bi-calendar-event me-2"></i>
                            Leave Details
                        </h3>
                    </div>

                    <div class="card-body-custom">

                <form asp-controller="Home" asp-action="LeaveRequest" method="post" class="row g-4">

                            <!-- Leave Type -->
                            <div class="col-md-6">
                                <label asp-for="LeaveType" class="form-label">Leave Type</label>
                                <select asp-for="LeaveType" class="form-select">
                                    <option value="">Select leave type</option>
                                    <option value="Annual">Annual Leave</option>
                                    <option value="Sick">Sick Leave</option>
                                    <option value="Unpaid">Unpaid Leave</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="LeaveType" class="text-danger"></span>
                            </div>

                            <!-- Start Date -->
                            <div class="col-md-3">
                                <label asp-for="StartDate" class="form-label">Start Date</label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <!-- End Date -->
                            <div class="col-md-3">
                                <label asp-for="EndDate" class="form-label">End Date</label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>

                            <!-- Reason -->
                            <div class="col-12">
                                <label asp-for="Reason" class="form-label">
                                    Reason <span class="text-muted">(optional)</span>
                                </label>
                                <textarea asp-for="Reason"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Add any additional context for your request"></textarea>
                            </div>

                            <!-- Info Box -->
                            <div class="col-12">
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Approved leaves will be permanently visible on both the admin
                                    and your calendar.
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="col-12 d-flex justify-content-end gap-3">

                                <button type="submit"
                                        class="action-btn action-btn-primary border-0">
                                    <div class="action-icon">
                                        <i class="bi bi-send"></i>
                                    </div>
                                    <div class="action-content">
                                        <span class="action-title">Submit Request</span>
                                        <span class="action-description">Send for approval</span>
                                    </div>
                                </button>

                            </div>

                        </form>
                            <hr />
                            <h5 class="mt-4">Your outgoing leave requests: </h5>

                @if (Model.OutgoingRequests.Any())
                {
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leave in Model.OutgoingRequests)
                            {
                                <tr>
                                    <td>
                                        @leave.StartDate.ToShortDateString()
                                        <i class="bi bi-arrow-right"></i>
                                        @leave.EndDate.ToShortDateString()
                                    </td>
                                    <td>@leave.LeaveType</td>
                                    <td>
                                        <span class="badge @GetStatusClass(leave.Status)">
                                            @leave.Status
                                        </span>
                                    </td>
                                    <td class="text-muted">
                                        @leave.Reason
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">
                        You have no upcoming leave requests.
                    </p>
                }


                    </div>
                </div>

            </div>
</div>

<script> // to color code the requests by status
    @functions {
    string GetStatusClass(LeaveStatus status) => status switch
    {
        LeaveStatus.Pending  => "bg-warning text-dark",
        LeaveStatus.Approved => "bg-success",
        LeaveStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
};

</script>