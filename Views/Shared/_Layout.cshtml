<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartStaff</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/NavBar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HRManagementSystem.styles.css" asp-append-version="true" />
    @*Bootstrap icons*@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @*google icon *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-professional">
            <div class="container-fluid px-4">
                <a class="navbar-brand-professional" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="">
                        <i class="bi bi-person-bounding-box"></i>
                    </span>
                    SmartStaff
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link-professional" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-professional" asp-area="" asp-controller="Employee" asp-action="Index">
                                <i class="bi bi-people me-1"></i>
                                Employees
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-professional" asp-area="" asp-controller="Payroll" asp-action="Index">
                                <i class="bi bi-cash-stack me-1"></i>
                                Payroll
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-professional" asp-area="" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-graph-up me-1"></i>
                                Reports
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <a class="nav-link-professional" asp-area="" asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person-circle me-1"></i>
                            Profile
                        </a>
                        <a class="btn-professional-primary" asp-area="" asp-controller="LogIn" asp-action="Index">
                            Sign In
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="main-content">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>
    <footer class="footer-professional">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <div class="footer-brand">
                        <i class="bi bi-briefcase-fill me-2"></i>
                        <span>SmartStaff</span>
                    </div>
                    <p class="footer-copyright mb-0">
                        <i class="bi bi-c-circle"></i> @DateTime.Now.Year SmartStaff | All rights reserved.
                    </p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="footer-links">
                        <a asp-area="" asp-controller="Home" asp-action="About">About</a>
                        <a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        <a asp-area="" asp-controller="Home" asp-action="Terms">Terms</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>