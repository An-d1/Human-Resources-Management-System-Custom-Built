<header class="dashboard-header">
    <div class="header-left">
        <button class="mobile-menu-toggle" id="sidebarToggle">
            <i class="bi bi-list"></i>
        </button>
        <div class="header-welcome">
            <h1 class="header-title">
                @(ViewData["HeaderTitle"] ?? "Dashboard")
            </h1>
            <p class="header-subtitle">
                @(ViewData["HeaderSubtitle"] ?? "Welcome back to your portal")
            </p>
        </div>
    </div>

    <div class="header-right">
        <div class="header-icon-btn">
            <i class="bi bi-bell"></i>
            <span class="notification-badge">3</span>
        </div>

        <div class="dropdown">
            <button class="user-profile-dropdown" id="userDropdown" data-bs-toggle="dropdown">
                <div class="user-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="user-info">
                    <span class="user-name">Admin</span>
                    <span class="user-email">admin@smartstaff.com</span>
                </div>
                <i class="bi bi-chevron-down"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="#"><i class="bi bi-person-circle me-2"></i> Profile</a></li>
                <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i> Settings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" asp-controller="LogIn" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
            </ul>
        </div>
    </div>
</header>
    