@model HRManagementSystem.ViewComponents.HeaderComponentViewModel

<header class="dashboard-header">
    <div class="header-left">
        <button class="mobile-menu-toggle" id="sidebarToggle">
            <i class="bi bi-list"></i>
        </button>
        <div class="header-welcome">
            <h1 class="header-title">@Model.Title</h1>
            <p class="header-subtitle">@Model.Subtitle</p>
        </div>
    </div>

    <div class="header-right">
        <div class="header-icon-btn">
            <i class="bi bi-bell"></i>
            <span class="notification-badge">2</span>
        </div>

        <div class="dropdown">
            <button class="user-profile-dropdown" id="userDropdown" data-bs-toggle="dropdown">
                <div class="user-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="user-info">
                    <span class="user-name">@Model.User?.FirstName @Model.User?.LastName</span>
                    <span class="user-email">@Model.User?.Email</span>
                </div>
                <i class="bi bi-chevron-down"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Profile</a></li>
                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index">Settings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" asp-controller="Login" asp-action="Logout">Sign Out</a></li>
            </ul>
        </div>
    </div>
</header>