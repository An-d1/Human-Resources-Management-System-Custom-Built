@using Microsoft.AspNetCore.Mvc
@(ViewContext.RouteData.Values["action"]!.ToString() == "<ActionName>" ? "active" : "")


<div class="smartstaff-sidebar" id="sidebar">
    <div class="sidebar-top">
        <div class="sidebar-brand">
            <i class="bi bi-person-bounding-box"></i>
            <span class="brand-text">SmartStaff</span>
        </div>

        <button class="sidebar-toggle" id="sidebarToggle">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <ul class="sidebar-menu">

        <!-- My Schedule -->
        <a asp-controller="Home" asp-action="Index"
           class="sidebar-link @(ViewContext.RouteData.Values["action"]!.ToString() == "Index" ? "active" : "")">
            <i class="bi bi-grid-fill"></i>
            <span>Employee Dashboard</span>
        </a>

        <!-- Check In / Out -->
        <a asp-controller="Home" asp-action="CheckInOut"
           class="sidebar-link @(ViewContext.RouteData.Values["action"]!.ToString() == "CheckInOut" ? "active" : "")">
            <i class="bi bi-clock-history"></i>
            <span>Check In / Out</span>
        </a>

        <a asp-controller="HolidayCalendar" asp-action="CalendarIndex"
           class="sidebar-link @(ViewContext.RouteData.Values["action"]!.ToString() == "CalendarIndex" ? "active" : "")">
            <i class="bi bi-calendar-week"></i>
            <span>Calendar</span>
        </a>

        <a asp-controller="Home" asp-action="LeaveRequest"
           class="sidebar-link @(ViewContext.RouteData.Values["action"]!.ToString() == "LeaveRequest" ? "active" : "")">
            <i class="bi bi-calendar-event"></i>
            <span>Request Leave</span>
        </a>

        <!-- Payroll -->
        <a asp-controller="Employee" asp-action="Payroll"
           class="sidebar-link @(ViewContext.RouteData.Values["action"]!.ToString() == "Payroll" ? "active" : "")">
            <i class="bi bi-cash"></i>
            <span>Payroll</span>
        </a>

        <!-- Profile -->
        <a asp-controller="Employee" asp-action="Profile"
           class="sidebar-link @(ViewContext.RouteData.Values["action"]!.ToString() == "Profile" ? "active" : "")">
            <i class="bi bi-person-circle"></i>
            <span>Profile</span>
        </a>

    </ul>

    <div class="sidebar-footer">
        <a asp-controller="Login" asp-action="Logout" class="sidebar-link logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </a>
    </div>
</div>
