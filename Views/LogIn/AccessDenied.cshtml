
<link rel="stylesheet" href="~/css/AccessDenied.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Authorization Required";
}
<div class="container-fluid d-flex flex-column justify-content-center align-items-center" style="min-height: 85vh;">

    <i class="bi bi-person-x-fill text-danger mb-4" style="font-size: 8rem;"></i>

    <header class="text-center mb-5" style="max-width: 700px;">
        <h1 class="display-3 fw-bolder text-dark mb-3">
            ACCESS DENIED
        </h1>
    </header>

    <div class="text-center" style="max-width: 500px;">

        <p class="fs-5 text-dark">
            You do not have the necessary permissions to view the requested resource.
        </p>

        <hr class="my-4 border-secondary" />

        <div class="d-grid gap-3">

            <p class="text-muted small mb-0 fs-5">What should I do now?</p>

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg fw-bold">
                <i class="bi bi-house-fill me-2"></i> Return to Your Dashboard
            </a>

            <button type="button" class="btn btn-outline-secondary btn-sm text-dark fw-semibold fs-5" data-bs-toggle="modal" data-bs-target="#supportModal">
                <i class="bi bi-question-circle me-2"></i> Contact HR Support
            </button>

        </div>
    </div>
</div>

<div class="modal fade" id="supportModal" tabindex="-1" aria-labelledby="supportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="supportModalLabel"><i class="bi bi-headset me-2"></i> Get Assistance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p>If you require access to this resource, please contact your supervisor or the IT Helpdesk.</p>
                <ul class="list-unstyled">
                    <li><i class="bi bi-telephone-fill me-2"></i> - Phone: +355 68 800 1242</li>
                    <li><i class="bi bi-envelope-fill me-2"></i> - Email: support@smartstaff.com</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
}