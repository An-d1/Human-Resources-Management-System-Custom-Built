@model HRManagementSystem.ViewModels.LogInViewModel
@{
    ViewData["Title"] = "Employee Log In";
}

<link rel="stylesheet" href="~/css/Account.css" asp-append-version="true" />

<div class="login-wrapper">
    <div class="login-container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

                <div class="login-card">
                    <div class="login-card-body">

                        <!-- Logo/Icon Section -->
                        <div class="login-icon-wrapper">
                            <div class="login-icon">
                                <i class="bi bi-briefcase-fill"></i>
                            </div>
                        </div>

                        <!-- Header Section -->
                        <div class="login-header">
                            <h1 class="login-title">Welcome Back</h1>
                            <p class="login-subtitle">Sign in to access your HR portal, payslips, and time tracking.</p>
                        </div>

                        <!-- Form Section -->
                        <form asp-action="LoginUser" method="post" novalidate class="login-form">

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger-professional" role="alert"></div>

                            <!-- Email Field -->
                            <div class="form-group-professional">
                                <label asp-for="Email" class="form-label-professional">Email Address</label>
                                <div class="input-wrapper">
                                    <span class="input-icon-left">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control-professional"
                                           placeholder="name@company.com"
                                           autocomplete="email" />
                                </div>
                                <span asp-validation-for="Email" class="validation-message"></span>
                            </div>

                            <!-- Password Field -->
                            <div class="form-group-professional">
                                <label asp-for="Password" class="form-label-professional">Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon-left">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="Password"
                                           type="password"
                                           id="passwordInput"
                                           class="form-control-professional"
                                           placeholder="Enter your password"
                                           autocomplete="current-password" />
                                    <button type="button"
                                            class="input-icon-right password-toggle-btn"
                                            id="togglePassword"
                                            tabindex="-1"
                                            aria-label="Show/Hide password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="validation-message"></span>
                            </div>

                            <!-- Remember Me & Forgot Password -->
                            <div class="login-options">
                                <div class="custom-checkbox">
                                    <input id="RememberMe"
                                           name="RememberMe"
                                           type="checkbox"
                                           class="checkbox-professional" />
                                    <label for="RememberMe" class="checkbox-label">Keep me signed in</label>
                                </div>

                                <a asp-controller="ForgotResetPassword"
                                   asp-action="ForgotPassword"
                                   class="link-professional">
                                    Forgot password?
                                </a>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn-login-professional">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Sign In
                            </button>

                        </form>

                        <!-- Divider -->
                        <div class="login-divider">
                            <span>or</span>
                        </div>

                        <!-- Footer Links -->
                        <div class="login-footer">
                            <p class="footer-text">
                                Don't have an account?
                                <a asp-controller="Register"
                                   asp-action="CompanyRegister"
                                   class="link-professional-bold">
                                    Register your company
                                </a>
                            </p>
                            <div class="security-notice">
                                <i class="bi bi-shield-check"></i>
                                <span>Your credentials are secure and encrypted</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Additional Info -->
                <div class="login-extra-info">
                    <p>Need help? Contact your HR administrator or visit our <a href="#" class="link-professional">support center</a>.</p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/LogIn.js" asp-append-version="true"></script>
}

<script>
    document.getElementById('togglePassword').addEventListener('click', function () {
        const passwordInput = document.getElementById('passwordInput');
        const icon = this.querySelector('i');
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        icon.classList.toggle('bi-eye');
        icon.classList.toggle('bi-eye-slash');
    });
</script>