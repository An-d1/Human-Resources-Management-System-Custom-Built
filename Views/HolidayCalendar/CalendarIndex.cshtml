<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css' rel='stylesheet' />
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>

@{
    ViewData["Title"] = "Holiday Calendar";
    bool isAdmin = ViewBag.IsAdmin == true;
}

<link rel="stylesheet" href="~/css/AdminDashboard.css" />
<link rel="stylesheet" href="~/css/Admin.css" />
<link rel="stylesheet" href="~/css/FullCalendar.css" />

<div class="dashboard-wrapper">

    <div class="dashboard-main">

        <header class="dashboard-header">
            <div class="header-left">
                <button class="mobile-menu-toggle" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>

                <div class="header-welcome">
                    <h1 class="header-title">Holiday Calendar</h1>
                    <p class="header-subtitle">Configure official holidays</p>
                </div>
            </div>
        </header>

        <div class="dashboard-content p-4">
            <div id="calendar"></div>
        </div>


        @* ADMIN ONLY: Add + Delete modals *@
        @if (isAdmin)
        {
            <!-- Add Holiday Modal -->
            <div class="modal fade" id="addHolidayModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">Add Holiday</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">

                            <div class="mb-3">
                                <label class="form-label">Holiday Name</label>
                                <input id="holidayName" type="text" class="form-control" placeholder="e.g. Christmas">
                            </div>

                            <label class="form-label">Holiday Type</label>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="holidayType" id="radioCompany" value="company">
                                <label class="form-check-label" for="radioCompany">Company Holiday</label>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="radio" name="holidayType" id="radioPublic" value="public">
                                <label class="form-check-label" for="radioPublic">Public Holiday</label>
                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" id="saveHolidayBtn">Save Holiday</button>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Delete Holiday Modal -->
            <div class="modal fade" id="deleteHolidayModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">Delete Holiday</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <p>Are you sure you want to delete <strong id="deleteHolidayName"></strong>?</p>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger" id="confirmDeleteHolidayBtn">Delete</button>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Import National Holidays Modal -->
            <div class="modal fade" id="importHolidaysModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">Import National Holidays</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">

                            <label class="form-label">Select Country</label>
                            <select id="countrySelect" class="form-select">
                                <option value="">-- Select a Country --</option>
                                <option value="AL">Albania</option>
                                <option value="IT">Italy</option>
                                <option value="DE">Germany</option>
                                <option value="FR">France</option>
                                <option value="CH">Switzerland</option>
                                <option value="AT">Austria</option>
                                <option value="US">United States</option>
                                <option value="UK">United Kingdom</option>
                                <option value="GR">Greece</option>
                                <option value="ES">Spain</option>
                                <option value="PT">Portugal</option>
                                <option value="NL">Netherlands</option>
                                <option value="BE">Belgium</option>
                                <option value="NO">Norway</option>
                                <option value="SE">Sweden</option>
                                <option value="DK">Denmark</option>
                                <option value="FI">Finland</option>
                                <option value="PL">Poland</option>
                                <option value="CZ">Czech Republic</option>
                            </select>

                            <label class="form-label mt-3">Year</label>
                            <input id="importYear" type="number" class="form-control" value="@DateTime.Now.Year">

                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button class="btn btn-primary" id="importHolidaysBtn">Import</button>
                        </div>

                    </div>
                </div>
            </div>
        }

        @if (isAdmin)
        {
            <div class="d-flex justify-content-center mt-3">
                <button class="btn btn-primary px-4 py-2 mb-5 shadow-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#importHolidaysModal">
                    <i class="bi bi-calendar2-plus"></i>
                    Import National Holidays
                </button>
            </div>

        }


    </div>
</div>


@section Scripts {
    <script>
                document.addEventListener('DOMContentLoaded', function () {

            var isAdmin = @isAdmin.ToString().ToLower();   // true/false

            // INITIALIZE FULLCALENDAR

            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                height: 750,

                selectable: isAdmin,              // Employees cannot select
                editable: isAdmin,                // Employees cannot drag/resize
                eventStartEditable: isAdmin,
                eventDurationEditable: isAdmin,

                events: '/HolidayCalendar/GetHolidays',


                // ADD HOLIDAY (DATE CLICK)
                dateClick: function (info) {
                    if (!isAdmin) return;

                    window.selectedHolidayDate = info.dateStr;

                    var modal = new bootstrap.Modal(document.getElementById('addHolidayModal'));
                    modal.show();
                },


                // DELETE HOLIDAY (EVENT CLICK)
                eventClick: function (info) {
                    if (!isAdmin) return;

                    window.selectedHolidayId = info.event.id;
                    document.getElementById('deleteHolidayName').innerText = info.event.title;

                    var modal = new bootstrap.Modal(document.getElementById('deleteHolidayModal'));
                    modal.show();
                },


                // MOVE HOLIDAY (DRAG)
                eventDrop: function (info) {

                    if (!isAdmin) {
                        info.revert();
                        return;
                    }

                    fetch('/HolidayCalendar/MoveHoliday', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            id: info.event.id,
                            newStartDate: info.event.startStr,
                            newEndDate: info.event.endStr  // For single-day events this may be null
                        })
                    })
                    .then(() => calendar.refetchEvents());
                },


                // RESIZE HOLIDAY (EXPAND / SHRINK)
                eventResize: function (info) {

                    if (!isAdmin) {
                        info.revert();
                        return;
                    }

                    fetch('/HolidayCalendar/ResizeHoliday', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            id: info.event.id,
                            newStartDate: info.event.startStr,
                            newEndDate: info.event.endStr
                        })
                    })
                    .then(() => calendar.refetchEvents());
                }
            });

            calendar.render();



            // ADD HOLIDAY CONFIRM BUTTON
            if (isAdmin) {

                document.getElementById('saveHolidayBtn').addEventListener('click', function () {

                    const name = document.getElementById('holidayName').value;
                    const selectedType = document.querySelector('input[name="holidayType"]:checked')?.value;

                    if (!name) {
                        alert("Please enter a holiday name.");
                        return;
                    }

                    const isCompany = selectedType === "company";
                    const isPublic = selectedType === "public";

                    fetch('/HolidayCalendar/AddHoliday', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            startDate: window.selectedHolidayDate,
                            endDate: window.selectedHolidayDate, // initially single-day
                            name: name,
                            isCompanyHoliday: isCompany,
                            isPublicHoliday: isPublic
                        })
                    })
                    .then(() => {
                        bootstrap.Modal.getInstance(document.getElementById('addHolidayModal')).hide();
                        calendar.refetchEvents();
                    });

                });



                // DELETE HOLIDAY CONFIRM BUTTON
                document.getElementById('confirmDeleteHolidayBtn').addEventListener('click', function () {

                    fetch('/HolidayCalendar/DeleteHoliday', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(window.selectedHolidayId)
                    })
                    .then(() => {
                        bootstrap.Modal.getInstance(document.getElementById('deleteHolidayModal')).hide();
                        calendar.refetchEvents();
                    });

                });

                // IMPORT NATIONAL HOLIDAYS (ADMIN ONLY)
                document.getElementById('importHolidaysBtn')?.addEventListener('click', function () {

                    const country = document.getElementById('countrySelect').value;
                    const year = document.getElementById('importYear').value;

                    if (!country) {
                        alert("Please choose a country.");
                        return;
                    }

                    fetch('/HolidayCalendar/ImportNationalHolidays', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            countryCode: country,
                            year: year
                        })
                    })
                    .then(r => {
                        if (!r.ok) {
                            alert("Failed to import national holidays!");
                            return;
                        }

                        bootstrap.Modal.getInstance(document.getElementById('importHolidaysModal')).hide();
                        calendar.refetchEvents();
                        alert("National holidays imported successfully!");
                    });

                });
            }

        });
    </script>
}
