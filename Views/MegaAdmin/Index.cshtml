@model List<Company>

@{
    ViewData["Title"] = "Pending Company Approvals";
    // Calculate the number of pending companies for the dashboard header
    var pendingCount = Model?.Count() ?? 0;
}

<link rel="stylesheet" href="~/css/MegaAdmin.css" asp-append-version="true" />


<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-bold text-dark">
            <i class="bi bi-people me-2 "></i> Pending Approvals
        </h1>
        <span class="badge bg-success fs-5 py-2 px-3 shadow-sm">
            @pendingCount Pending
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-success border-0 shadow-sm p-4 mt-5 d-flex align-items-center">
            <i class="bi bi-cup-straw fs-1"></i>
            <span class="fs-5">All caught up! There are currently no companies awaiting approval.</span>
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
                <h5 class="card-title mb-0 text-dark">New Company Inquiries</h5>
            </div>
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-striped table-borderless table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-uppercase small fw-bold text-muted">
                                <th scope="col" style="width: 20%;">#Id</th>
                                <th scope="col" style="width: 20%;">Company Name</th>
                                <th scope="col" style="width: 10%;">Tax ID</th>
                                <th scope="col" style="width: 20%;">Email</th>
                                <th scope="col" style="width: 10%;">Phone</th>
                                <th scope="col" style="width: 10%;">Status</th>
                                <th scope="col" class="text-center" style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-primary">@company.Id</span>
                                    </td>
                                    <td>@company.Name</td>
                                    <td>@company.TaxId</td>
                                    <td><a href="mailto:@company.CompanyEmail" class="text-decoration-none">@company.CompanyEmail</a></td>
                                    <td>@company.CompanyPhoneNumber</td>
                                    <td>
                                        <span class="badge rounded-pill bg-warning text-dark px-3 py-2 fw-semibold">
                                            <i class="bi bi-clock me-1"></i> Pending
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <form asp-action="ApproveCompany" asp-controller="MegaAdmin" method="post" class="d-inline">
                                                <input type="hidden" name="companyId" value="@company.Id" />
                                                <button type="submit" class="btn btn-success me-3" title="Approve Company">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <form asp-action="RejectCompany" asp-controller="MegaAdmin" method="post" class="d-inline">
                                                <input type="hidden" name="companyId" value="@company.Id" />
                                                <button type="submit" class="btn btn-danger" title="Reject Company">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }
</div>