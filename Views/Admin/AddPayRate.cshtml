@using HRManagementSystem.ViewModels
@model AddPayRateViewModel

@{
    ViewData["HeaderTitle"] = "Update Compensation";
    ViewData["HeaderSubtitle"] = "Add a new pay rate for " + Model.FullName;
}

<div class="dashboard-wrapper">
    <div class="dashboard-main">

        @await Html.PartialAsync("_AdminHeader")

        <main class="dashboard-content">

            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">

                    <div class="content-card">

                        <div class="card-header-custom">
                            <h3 class="card-title-custom">
                                <i class="bi bi-cash-coin me-2"></i>New Pay Rate
                            </h3>
                        </div>

                        <div class="p-4">
                            <form asp-action="AddPayRate" method="post">
                                <input type="hidden" asp-for="UserId" />
                                <input type="hidden" asp-for="FullName" />

                                <div class="mb-4 text-center">
                                    <div class="text-muted small text-uppercase tracking-wide">Employee</div>
                                    <div class="fw-bold fs-5">@Model.FullName</div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="HourlyRate" class="form-label text-muted small fw-bold">New Hourly Rate</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0">
                                            <i class="bi bi-currency-dollar text-muted"></i>
                                        </span>
                                        <input asp-for="HourlyRate" class="form-control border-start-0 ps-0" placeholder="0.00" type="number" step="0.01" />
                                    </div>
                                    <span asp-validation-for="HourlyRate" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="EffectiveDate" class="form-label text-muted small fw-bold">Effective From</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0">
                                            <i class="bi bi-calendar-event text-muted"></i>
                                        </span>
                                        <input asp-for="EffectiveDate" type="date" class="form-control border-start-0 ps-0" />
                                    </div>
                                    <div class="form-text small">
                                        The new rate will become active on this date.
                                    </div>
                                    <span asp-validation-for="EffectiveDate" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <hr class="my-4 text-muted" style="opacity: 0.1">

                                <div class="d-flex justify-content-end gap-3">
                                    <a asp-controller="Admin" asp-action="EmployeeDetails" asp-route-id="@Model.UserId"
                                       class="btn btn-light d-inline-flex align-items-center">
                                        Cancel
                                    </a>

                                    <button type="submit" class="btn-add-employee d-inline-flex align-items-center px-4">
                                        <i class="bi bi-check-lg me-2"></i>
                                        <span>Save New Rate</span>
                                    </button>
                                </div>

                            </form>
                        </div>
                    </div>

                </div>
            </div>

        </main>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}