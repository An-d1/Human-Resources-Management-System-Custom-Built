@using HRManagementSystem.ViewModels
@model IEnumerable<DepartmentViewModel>
@{
    ViewData["Title"] = "Departments Management";
}

<link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />

<div class="dashboard-wrapper">

    <nav class="dashboard-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <i class="bi bi-briefcase-fill"></i>
                <span>SmartStaff</span>
            </div>
            <span class="sidebar-badge">Admin</span>
        </div>

        <ul class="sidebar-nav">
            <li class="nav-item">
                <a asp-controller="Admin" asp-action="Index" class="nav-link">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Admin" asp-action="Employees" class="nav-link">
                    <i class="bi bi-people-fill"></i>
                    <span>Employees</span>
                </a>
            </li>
            <li class="nav-item active">
                <a asp-controller="Admin" asp-action="DepartmetnsList" class="nav-link">
                    <i class="bi bi-building"></i>
                    <span>Departments</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Payroll" asp-action="Index" class="nav-link">
                    <i class="bi bi-cash-stack"></i>
                    <span>Payroll</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Reports" asp-action="Index" class="nav-link">
                    <i class="bi bi-file-earmark-bar-graph-fill"></i>
                    <span>Reports</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Settings" asp-action="Index" class="nav-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <a asp-controller="LogIn" asp-action="Logout" class="btn-logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sign Out</span>
            </a>
        </div>
    </nav>

    <div class="dashboard-main">

        <header class="dashboard-header">
            <div class="header-left">
                <button class="mobile-menu-toggle" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>
                <div class="header-welcome">
                    <h1 class="header-title">Department Management</h1>
                    <p class="header-subtitle">Organize and manage company structure</p>
                </div>
            </div>

            <div class="header-right">
                <div class="header-icon-btn">
                    <i class="bi bi-bell"></i>
                    <span class="notification-badge">2</span>
                </div>

                <div class="dropdown">
                    <button class="user-profile-dropdown" id="userDropdown" data-bs-toggle="dropdown">
                        <div class="user-avatar">AU</div>
                        <div class="user-info">
                            <span class="user-name">Admin User</span>
                            <span class="user-email">admin@smartstaff.com</span>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person-circle me-2"></i> Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i> Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-controller="LogIn" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="dashboard-content">

            <div class="action-bar">
                <div class="action-bar-left">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" id="searchInput" placeholder="Search departments..." class="search-input">
                    </div>
                </div>
                <div class="action-bar-right">
                    <button class="btn-export">
                        <i class="bi bi-download"></i>
                        <span>Export List</span>
                    </button>
                    <a asp-controller="Admin" asp-action="AddDepartmentView" class="btn-add-employee">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>Add Department</span>
                    </a>
                </div>
            </div>

            <div class="employee-stats-grid">
                <div class="employee-stat-card">
                    <div class="stat-icon-small stat-icon-primary">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number">@Model.Count()</span>
                        <span class="stat-text">Total Departments</span>
                    </div>
                </div>
                <div class="employee-stat-card">
                    <div class="stat-icon-small stat-icon-info">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number">Active</span>
                        <span class="stat-text">Status</span>
                    </div>
                </div>
            </div>

            <div class="content-card employees-table-card">
                <div class="card-header-custom">
                    <h3 class="card-title-custom">All Departments</h3>
                    <span class="employee-count-badge">@Model.Count() departments</span>
                </div>
                <div class="table-responsive">
                    <table class="employees-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">
                                    <input type="checkbox" id="selectAll" class="table-checkbox">
                                </th>
                                <th>Department Details</th>
                                <th>Department ID</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="departmentTableBody">
                            @foreach (var dept in Model)
                            {
                                <tr class="employee-row">
                                    <td>
                                        <input type="checkbox" class="table-checkbox">
                                    </td>
                                    <td>
                                        <div class="employee-info">
                                            <div class="employee-avatar" style="background-color: #eef2ff; color: #4f46e5;">
                                                @(string.IsNullOrEmpty(dept.DepartmentName) ? "?" : dept.DepartmentName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div class="employee-details">
                                                <span class="employee-name">@dept.DepartmentName</span>
                                                <span class="employee-meta">Active</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="employee-id">@dept.DepartmentId</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="action-buttons justify-content-end">
                                            <a asp-action="Edit" asp-route-id="@dept.DepartmentId" class="action-icon-btn action-edit" title="Edit Department Name">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-action="Delete" asp-route-id="@dept.DepartmentId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this department?');">
                                                <button type="submit" class="action-icon-btn action-view text-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-building-dash"></i>
                            <h3>No Departments Found</h3>
                            <p>Create your first department to get started.</p>
                            <a asp-controller="Admin" asp-action="AddDepartmentView" class="btn-add-employee">
                                <i class="bi bi-plus-circle"></i>
                                <span>Add Department</span>
                            </a>
                        </div>
                    }
                </div>
            </div>

        </main>

    </div>

</div>

@section Scripts
{
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function() {
            let searchValue = this.value.toLowerCase();
            let tableRows = document.querySelectorAll('#departmentTableBody tr');

            tableRows.forEach(row => {
                let name = row.querySelector('.employee-name').textContent.toLowerCase();
                if (name.includes(searchValue)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
}