@using HRManagementSystem.ViewModels
@model IEnumerable<EmployeeViewModel>

@{
    ViewData["HeaderTitle"] = "Employees Management";
    ViewData["HeaderSubtitle"] = "Manage and view all your employees information";
}

<link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />

<div class="dashboard-wrapper">

    <!-- Main Content Area -->
    <div class="dashboard-main">

        @await Html.PartialAsync("_AdminHeader")
        <!-- Dashboard Content -->
        <main class="dashboard-content">
            @await Html.PartialAsync("_FlashMessages")

            <!-- Action Bar -->
            <div class="action-bar">
                <div class="action-bar-left">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" id="searchInput" placeholder="Search employees by name, ID, or role..." class="search-input">
                    </div>
                    <div class="filter-group">
                        <button class="filter-btn" id="filterDropdown" data-bs-toggle="dropdown">
                            <i class="bi bi-funnel"></i>
                            <span>Filter</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" data-filter="all">All Employees</a></li>
                            <li><a class="dropdown-item" href="#" data-filter="active">Active Only</a></li>
                            <li><a class="dropdown-item" href="#" data-filter="recent">Recently Hired</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" data-filter="manager">Managers</a></li>
                            <li><a class="dropdown-item" href="#" data-filter="developer">Developers</a></li>
                            <li><a class="dropdown-item" href="#" data-filter="hr">HR Staff</a></li>
                        </ul>
                    </div>
                </div>
                <div class="action-bar-right">
                    <button class="btn-export">
                        <i class="bi bi-download"></i>
                        <span>Export</span>
                    </button>
                    <a asp-controller="EmployeeLevel" asp-action="CreateEmployeeLevelView" class="btn-add-employee">
                        <i class="bi bi-person-rolodex"></i>
                        <span>Add Employee Levels</span>
                    </a>
                    <a asp-controller="Register" asp-action="Index" class="btn-add-employee">
                        <i class="bi bi-person-plus"></i>
                        <span>Add Employee</span>
                    </a>
                </div>
            </div>

            <!-- Stats Overview -->
            <div class="employee-stats-grid">
                <div class="employee-stat-card">
                    <div class="stat-icon-small stat-icon-primary">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number">@Model.Count()</span>
                        <span class="stat-text">Total Employees</span>
                    </div>  
                </div>
                <div class="employee-stat-card">
                    <div class="stat-icon-small stat-icon-success">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number">@Model.Count(e => e.IsEmployed & e.IsEmailConfirmed == true)</span>
                        <span class="stat-text">Active</span>
                    </div>
                </div>
            </div>

            <!-- Employees Table -->
            <div class="content-card employees-table-card">
                <div class="card-header-custom">
                    <h3 class="card-title-custom">All Employees</h3>
                    <span class="employee-count-badge">@Model.Count() employees</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle employees-table">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" id="selectAll" class="table-checkbox">
                                </th>
                                <th>Employee Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Level</th>
                                <th>Department</th>  
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="employeeTableBody">
                            @foreach (var employee in Model)
                            {
                                <tr class="employee-row">
                                    <td>
                                        <input type="checkbox" class="table-checkbox employee-checkbox">
                                    </td>
                                    <td>
                                        <div class="employee-info">
                                            <div class="employee-avatar">
                                                @employee.FirstName.Substring(0, 1)@employee.LastName.Substring(0, 1)
                                            </div>
                                            <div class="employee-details">
                                                <span class="employee-name">@employee.FirstName @employee.LastName</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="employee-email">@employee.Email</span>
                                    </td>

                                    <td>
                                        <span class="role-badge role-@employee.Role.ToLower().Replace(" ", "-")">
                                            @employee.Role
                                        </span>
                                    </td>

                                    <td>
                                        <span class="role-badge role-@employee.Role.ToLower().Replace(" ", "-")">
                                            @employee.EmployeeLevel
                                        </span>
                                    </td>

                                    <td>
                                        @if (employee.Departments.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var dept in employee.Departments)
                                                {
                                                    <span class="badge rounded-pill bg-light text-dark border department-badge">
                                                        <i class="bi bi-diagram-3 me-1"></i>@dept
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No Department</span>
                                        }
                                    </td>

                                    <!-- STATUS -->
                                    <td>
                                        @if (employee.IsEmployed && employee.IsEmailConfirmed == true)
                                        {
                                            <span class="status-badge status-active">
                                                <i class="bi bi-check-circle-fill"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <i class="bi bi-x-circle-fill"></i> Inactive
                                            </span>
                                        }
                                    </td>

                                    <!-- ACTIONS -->
                                    <td>
                                        <div class="action-buttons">
                                            <a asp-controller="Admin"
                                               asp-action="EmployeeDetails"
                                               asp-route-id="@employee.UserId"
                                               class="action-icon-btn action-view" title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <form asp-action="TerminateEmployeeContract"
                                                  asp-controller="Admin"
                                                  method="post"
                                                  class="d-inline">
                                                <input type="hidden" name="userId" value="@employee.UserId" />
                                                <button class="action-icon-btn action-view" title="Terminate">
                                                    <i class="bi bi-file-earmark-excel"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-people"></i>
                            <h3>No Employees Found</h3>
                            <p>Get started by adding your first employee to the system.</p>
                            <a asp-controller="Register" asp-action="Index" class="btn-add-employee">
                                <i class="bi bi-person-plus"></i>
                                <span>Add Employee</span>
                            </a>
                        </div>
                    }
                </div>
            </div>

        </main>

    </div>

</div>

@section Scripts
{
    <script src="~/js/EmployeePageInteractions.js" asp-append-version="true"></script>
}
