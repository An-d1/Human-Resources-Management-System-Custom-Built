@model HRManagementSystem.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - HR Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />

</head>
<body>

    <div class="wrapper">

        <nav class="sidebar">
            <div class="sidebar-header">
                <h4 class="mb-0 text-white"><i class="bi bi-shield-lock me-2"></i> HR Admin</h4>
            </div>

            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link active" href="#"><i class="bi bi-grid-fill me-2"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#"><i class="bi bi-people-fill me-2"></i> Employees</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#"><i class="bi bi-file-earmark-bar-graph-fill me-2"></i> Reports</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#"><i class="bi bi-calendar-check-fill me-2"></i> Time Tracking</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#"><i class="bi bi-gear-fill me-2"></i> Settings</a>
                </li>
            </ul>

            <div class="p-3 mt-auto text-center">
                <a asp-controller="LogIn" asp-action="Logout" class="btn btn-sm btn-outline-light w-75"><i class="bi bi-box-arrow-right"></i> Logout</a>
            </div>
        </nav>

        <div class="main-content">

            <header class="top-navbar d-flex justify-content-between align-items-center">
                <h2 class="h4 mb-0 text-dark">Welcome Back, Admin User!</h2>

                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="https://via.placeholder.com/40/0d6efd/FFFFFF?text=AU" alt="User" width="40" height="40" class="rounded-circle me-2 border border-primary">
                        <strong class="d-none d-sm-inline">Admin.User@HR.com</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person-circle me-2"></i> Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-bell me-2"></i> Notifications</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-controller="LogIn" asp-action=" Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign out</a></li>
                    </ul>
                </div>
            </header>

            <main class="p-4 p-md-5">

                <div class="row g-4 mb-5">

                    <div class="col-sm-6 col-lg-3">
                        <div class="card dashboard-card h-100 p-3">
                            <div class="card-body">
                                <h5 class="card-title text-primary"><i class="bi bi-person-badge-fill me-2"></i> Total Employees</h5>
                                <h1 class="display-4 fw-bold">1,245</h1>
                                <p class="card-text text-secondary small">Registered in the system.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="card dashboard-card h-100 p-3">
                            <div class="card-body">
                                <h5 class="card-title text-success"><i class="bi bi-clock-history me-2"></i> Pending PTO</h5>
                                <h1 class="display-4 fw-bold">42</h1>
                                <p class="card-text text-secondary small">Vacation requests awaiting approval.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="card dashboard-card h-100 p-3">
                            <div class="card-body">
                                <h5 class="card-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i> Open Tickets</h5>
                                <h1 class="display-4 fw-bold">8</h1>
                                <p class="card-text text-secondary small">Unresolved HR support issues.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="card dashboard-card h-100 p-3">
                            <div class="card-body">
                                <h5 class="card-title text-info"><i class="bi bi-person-plus-fill me-2"></i> New Hires (30d)</h5>
                                <h1 class="display-4 fw-bold">12</h1>
                                <p class="card-text text-secondary small">New employees onboarded.</p>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row g-4">

                    <div class="col-lg-8">
                        <div class="card dashboard-card h-100">
                            <div class="card-header bg-white border-0">
                                <h5 class="mb-0">Recent System Activity</h5>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i> Employee J. Smith approved PTO.
                                        <span class="badge bg-secondary">2 mins ago</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <i class="bi bi-upload text-primary me-2"></i> Payroll files for Q3 uploaded.
                                        <span class="badge bg-secondary">1 hour ago</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <i class="bi bi-person-fill-add text-info me-2"></i> New user A. Johnson registered.
                                        <span class="badge bg-secondary">3 hours ago</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card dashboard-card h-100">
                            <div class="card-header bg-white border-0">
                                <h5 class="mb-0">Quick Actions</h5>
                            </div>
                            <div class="card-body d-grid gap-3">
                                <a asp-controller="Register" asp-action="Index" class="btn btn-outline-primary">
                                    <i class="bi bi-person-plus me-2"></i> Add New Employee
                                </a>
                                <button class="btn btn-outline-success"><i class="bi bi-file-earmark-spreadsheet me-2"></i> Export Payroll Data</button>
                                <button class="btn btn-outline-warning"><i class="bi bi-ticket-detailed me-2"></i> Review Helpdesk Tickets</button>
                            </div>
                        </div>
                    </div>

                </div>

            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts
    {
    }

</body>
</html>