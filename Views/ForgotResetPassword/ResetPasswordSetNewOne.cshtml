@model HRManagementSystem.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/css/Account.css" asp-append-version="true" />

<div class="login-wrapper">
    <div class="login-container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

                <div class="login-card">
                    <div class="login-card-body">

                        <!-- Logo/Icon -->
                        <div class="login-icon-wrapper">
                            <div class="login-icon">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                        </div>

                        <!-- Header -->
                        <div class="login-header">
                            <h1 class="login-title">Reset Your Password</h1>
                            <p class="login-subtitle">Enter your new password below to regain access.</p>
                        </div>

                        <!-- Form -->
                        <form asp-action="ResetPasswordUser" method="post" novalidate class="login-form">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger-professional"></div>

                            <input type="hidden" asp-for="UserId" />
                            <input type="hidden" asp-for="Token" />

                            <!-- New Password -->
                            <div class="form-group-professional">
                                <label asp-for="NewPassword" class="form-label-professional">New Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon-left">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="NewPassword"
                                           type="password"
                                           id="newPasswordInput"
                                           class="form-control-professional"
                                           placeholder="Enter new password" />
                                    <button type="button"
                                            class="input-icon-right password-toggle-btn"
                                            data-target="newPasswordInput"
                                            tabindex="-1">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="validation-message"></span>
                            </div>

                            <!-- Confirm New Password -->
                            <div class="form-group-professional">
                                <label asp-for="ConfirmNewPassword" class="form-label-professional">Confirm Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon-left">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input asp-for="ConfirmNewPassword"
                                           type="password"
                                           id="confirmPasswordInput"
                                           class="form-control-professional"
                                           placeholder="Re-enter new password" />
                                    <button type="button"
                                            class="input-icon-right password-toggle-btn"
                                            data-target="confirmPasswordInput"
                                            tabindex="-1">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmNewPassword" class="validation-message"></span>
                            </div>

                            <!-- Submit -->
                            <button type="submit" class="btn-login-professional">
                                <i class="bi bi-check2-circle me-2"></i>
                                Change Password
                            </button>

                        </form>

                        <!-- Divider -->
                        <div class="login-divider">
                            <span>or</span>
                        </div>

                        <!-- Footer Links -->
                        <div class="login-footer">
                            <p class="footer-text">
                                Remembered your password?
                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="link-professional-bold">
                                    Sign in instead
                                </a>
                            </p>
                            <div class="security-notice">
                                <i class="bi bi-shield-check"></i>
                                <span>Your credentials remain secure</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="login-extra-info">
                    <p>
                        Need help? Contact your HR administrator or visit our
                        <a href="#" class="link-professional">support center</a>.
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    // Generic password toggler for multiple fields
    document.querySelectorAll(".password-toggle-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            const targetId = this.getAttribute("data-target");
            const input = document.getElementById(targetId);
            const icon = this.querySelector("i");

            const type = input.getAttribute("type") === "password" ? "text" : "password";
            input.setAttribute("type", type);

            icon.classList.toggle("bi-eye");
            icon.classList.toggle("bi-eye-slash");
        });
    });
</script>
