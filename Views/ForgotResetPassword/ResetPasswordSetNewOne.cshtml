@model HRManagementSystem.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container-fluid py-5 page-dark">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-7 col-xl-6">
            <div class="card shadow-lg border-0 card-dark rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-3">
                        <h3 class="h2 fw-bold text-primary mb-2">Reset Password</h3>
                        <p class="text-muted mb-0">Enter and confirm your new password.</p>
                    </div>

                    <!-- This needs to be ridesigned-->
                    <form asp-action="ResetPasswordUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control form-control-lg input-dark"
                                   placeholder="New Password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <input asp-for="ConfirmNewPassword"
                                   type="password"
                                   class="form-control form-control-lg input-dark"
                                   placeholder="Confirm New Password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Change Password
                        </button>
                    </form>

                    <hr class="my-4">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
