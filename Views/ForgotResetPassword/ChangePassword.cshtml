@model HRManagementSystem.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<link rel="stylesheet" href="~/css/Account.css" asp-append-version="true" />

<div class="login-wrapper">
    <div class="login-container">
        @await Html.PartialAsync("_FlashMessages")

        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

                <div class="login-card">
                    <div class="login-card-body">

                        <div class="login-icon-wrapper">
                            <div class="login-icon">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                        </div>

                        <div class="login-header">
                            <h1 class="login-title">Change Password</h1>
                            <p class="login-subtitle">To secure your account, please verify your current password.</p>
                        </div>

                        <form asp-action="ChangePassword" method="post" novalidate class="login-form">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger-professional"></div>

                            <div class="form-group-professional">
                                <label asp-for="CurrentPassword" class="form-label-professional">Current Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon-left">
                                        <i class="bi bi-key"></i>
                                    </span>
                                    <input asp-for="CurrentPassword"
                                           type="password"
                                           id="currentPasswordInput"
                                           class="form-control-professional"
                                           placeholder="Enter current password" />
                                    <button type="button"
                                            class="input-icon-right password-toggle-btn"
                                            data-target="currentPasswordInput"
                                            tabindex="-1">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="CurrentPassword" class="validation-message"></span>
                            </div>

                            <div class="form-group-professional">
                                <label asp-for="NewPassword" class="form-label-professional">New Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon-left">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="NewPassword"
                                           type="password"
                                           id="newPasswordInput"
                                           class="form-control-professional"
                                           placeholder="Enter new password" />
                                    <button type="button"
                                            class="input-icon-right password-toggle-btn"
                                            data-target="newPasswordInput"
                                            tabindex="-1">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="validation-message"></span>
                            </div>

                            <div class="form-group-professional">
                                <label asp-for="ConfirmNewPassword" class="form-label-professional">Confirm New Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon-left">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input asp-for="ConfirmNewPassword"
                                           type="password"
                                           id="confirmPasswordInput"
                                           class="form-control-professional"
                                           placeholder="Re-enter new password" />
                                    <button type="button"
                                            class="input-icon-right password-toggle-btn"
                                            data-target="confirmPasswordInput"
                                            tabindex="-1">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmNewPassword" class="validation-message"></span>
                            </div>

                            <button type="submit" class="btn-login-professional">
                                <i class="bi bi-check2-circle me-2"></i>
                                Update Password
                            </button>

                            <div class="login-divider">
                                <span>or</span>
                            </div>

                            <div class="login-footer">
                                <p class="footer-text">
                                    Changed your mind?
                                    <a asp-controller="Home" asp-action="Index" class="link-professional-bold">
                                        Return to Dashboard
                                    </a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    document.querySelectorAll(".password-toggle-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            const targetId = this.getAttribute("data-target");
            const input = document.getElementById(targetId);
            const icon = this.querySelector("i");
            const type = input.getAttribute("type") === "password" ? "text" : "password";
            input.setAttribute("type", type);
            icon.classList.toggle("bi-eye");
            icon.classList.toggle("bi-eye-slash");
        });
    });
</script>