@model HRManagementSystem.ViewModels.ForgotPasswordViewModel

<link rel="stylesheet" href="~/css/Account.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/Account.css" asp-append-version="true" />

<div class="login-wrapper">
    <div class="login-container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

                <div class="login-card">
                    <div class="login-card-body">

                        <!-- Logo/Icon Section -->
                        <div class="login-icon-wrapper">
                            <div class="login-icon forgot-password-icon">
                                <i class="bi bi-key-fill"></i>
                            </div>
                        </div>

                        <!-- Header Section -->
                        <div class="login-header">
                            <h1 class="login-title">Reset Your Password</h1>
                            <p class="login-subtitle">Enter your email address and we'll send you a secure link to reset your password.</p>
                        </div>

                        <!-- Form Section -->
                        <form asp-action="ForgotPassword" method="post" novalidate class="login-form">

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger-professional" role="alert"></div>

                            <!-- Email Field -->
                            <div class="form-group-professional">
                                <label asp-for="Email" class="form-label-professional">Email Address</label>
                                <div class="input-wrapper">
                                    <span class="input-icon-left">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control-professional"
                                           placeholder="name@company.com"
                                           autocomplete="email" />
                                </div>
                                <span asp-validation-for="Email" class="validation-message"></span>
                            </div>

                            <!-- Info Notice -->
                            <div class="info-notice mb-4 text-center text-muted">
                                <i class="bi bi-info-circle"></i>
                                <p>
                                    The password reset link will be valid for 1 hour. Make sure to check your spam folder if you don't receive the email.
                                </p>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn-login-professional">
                                <i class="bi bi-arrow-right-circle me-2"></i>
                                Send Reset Link
                            </button>

                            <!-- Back Button -->
                            <a asp-controller="LogIn" asp-action="Index" class="btn-secondary-professional">
                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Login
                            </a>

                        </form>

                        <!-- Divider -->
                        <div class="login-divider">
                            <span>Need help?</span>
                        </div>

                        <!-- Footer Links -->
                        <div class="login-footer">
                            <div class="contact-info-box">
                                <i class="bi bi-envelope-at"></i>
                                <div>
                                    <p class="contact-label">
                                        smartstaff@help.com
                                    </p>
                                </div>
                            </div>
                            <div class="security-notice">
                                <i class="bi bi-shield-lock"></i>
                                <span>Your password reset request is secure and encrypted</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Additional Info -->
                <div class="login-extra-info">
                    <p>Contact your administrator if you continue to experience issues accessing your account.</p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const emailInput = document.querySelector('input[type="email"]');
            const form = document.querySelector('form');

            // Add active states to input
            if (emailInput) {
                emailInput.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.classList.add('has-value');
                    } else {
                        this.classList.remove('has-value');
                    }
                });

                emailInput.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });

                emailInput.addEventListener('blur', function() {
                    this.parentElement.classList.remove('focused');
                });
            }

            // Form submission handling
            if (form) {
                form.addEventListener('submit', function(e) {
                    const submitBtn = this.querySelector('.btn-login-professional');

                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sending...';

                        setTimeout(() => {
                            if (!form.checkValidity()) {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = '<i class="bi bi-arrow-right-circle me-2"></i>Send Reset Link';
                            }
                        }, 100);
                    }
                });
            }

            // Auto-focus email input
            if (emailInput) {
                emailInput.focus();
            }
        });
    </script>
}