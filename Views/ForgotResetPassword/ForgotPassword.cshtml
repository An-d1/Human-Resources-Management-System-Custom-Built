@model HRManagementSystem.ViewModels.ForgotPasswordViewModel

<link rel="stylesheet" href="~/css/Account.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5 mt-5">

            <div class="card login-card shadow-lg border-0">
                <div class="card-body p-5">

                    <div class="text-center mb-2">
                        <i class="bi bi-key-fill text-primary" style="font-size: 3.5rem;"></i>
                    </div>

                    <div class="text-center mb-4">
                        <h1 class="h3 header-title mb-1">Reset Your Password</h1>
                        <p class="text-secondary fs-6 mb-0 mt-3">Enter your email and we'll send you a link to reset your password.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post" novalidate>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label text-white">Email address</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email"
                                       class="form-control form-control-dark"
                                       placeholder="name@company.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-3">

                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-arrow-right-circle me-2"></i> Send Reset Link
                            </button>

                            <a asp-controller="LogIn" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Back to Log In
                            </a>

                        </div>
                    </form>

                    <hr class="my-5 border-gray-200" />

                    <div class="text-center">
                        <p class="text-sm text-secondary mb-0">
                          
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}